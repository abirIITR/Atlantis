    <style>
        :root {
            /* Single Accent Color */
            --accent-color: #006B75; 
            
            /* Standard News Palette */
            --bg-color: #FFFFFF;
            --bg-alt: #F4F4F4;
            --text-main: #1A1A1A;
            --text-muted: #555555;
            --border-color: #E2E2E2;
            
            /* Typography */
            --font-headline: 'Georgia', Times, serif;
            --font-body: 'Helvetica Neue', Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
        }

        /* Top utility bar */
        .top-bar {
            background-color: var(--bg-alt);
            border-bottom: 1px solid var(--border-color);
            padding: 0.5rem 5%;
            font-size: 0.75rem;
            display: flex;
            justify-content: space-between;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Main Header */
        header {
            padding: 2rem 5%;
            border-bottom: 4px solid var(--accent-color);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo {
            font-family: var(--font-headline);
            font-size: 3.5rem;
            font-weight: bold;
            color: var(--text-main);
            text-transform: uppercase;
            letter-spacing: -1px;
            margin-bottom: 1rem;
        }

        /* Navigation */
        nav {
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 2rem;
        }

        nav a {
            text-decoration: none;
            color: var(--text-main);
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        nav a:hover {
            color: var(--accent-color);
        }

        /* Breaking News Banner */
        .breaking-banner {
            background-color: var(--accent-color);
            color: white;
            padding: 0.75rem 5%;
            font-weight: bold;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .breaking-label {
            background-color: white;
            color: var(--accent-color);
            padding: 0.2rem 0.5rem;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
        }

        /* Main Layout */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 5%;
            display: grid;
            grid-template-columns: 2.5fr 1fr;
            gap: 3rem;
        }

        /* Article Styling */
        .article-category {
            color: var(--accent-color);
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            display: inline-block;
