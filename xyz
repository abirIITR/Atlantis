            font-family: var(--font-headline);
            font-size: 3rem;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            color: var(--text-main);
        }

        .article-deck {
            font-size: 1.25rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
            line-height: 1.4;
        }

        .byline {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border-color);
            margin-bottom: 2rem;
        }

        .byline-info {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .byline-name {
            font-weight: bold;
            color: var(--text-main);
            text-decoration: none;
        }

        .hero-media {
            width: 100%;
            background-color: white
            border: 0px solid var(--border-color);
            margin-bottom: 0.5rem;
            position: relative;
        }

        .hero-media img {
